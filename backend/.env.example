# Google Gemini API key configuration
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Default Region
AWS_DEFAULT_REGION=us-east-1

# ─── SaaS Platform AWS Identity (PERMANENT IAM User credentials) ─────────────
# These credentials are used by THIS backend to call sts:AssumeRole into customer accounts.
# IMPORTANT: These must be a *permanent* IAM User Access Key — NOT temporary STS tokens.
# Temporary credentials (from assumed roles, CloudFormation, etc.) expire after ~1 hour
# and cause "InvalidClientTokenId" errors on all scans.
#
# How to set up (one-time):
#   1. AWS Console → IAM → Users → Create User (e.g. "cloud-cost-saas-scanner")
#   2. Attach inline policy: { "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "*" }
#   3. Security credentials → Create access key → copy the values below
#   4. This key NEVER expires (until you rotate/delete it manually).
#
AWS_SAAS_ACCOUNT_ID=717056864326
AWS_ACCESS_KEY_ID=AKIA_YOUR_PERMANENT_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=your_permanent_secret_access_key_here
# ─────────────────────────────────────────────────────────────────────────────

# InsForge Managed Database Configuration
INSFORGE_PROJECT_URL=https://your-project.us-east.insforge.app
INSFORGE_ANON_KEY=your_insforge_anon_key_here

# PostgreSQL High Concurrency Connection
DATABASE_URL=postgresql://clouduser:cloudpass@localhost:5432/cloudcost
DB_PATH=/app/data/db.sqlite3

# API Security & Authentication
API_SECRET_KEY=your_api_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email & Alert Notifications (Injected from Vault in Prod)
GMAIL_USER=alerts@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password_here

# HashiCorp Vault Secrets Management
VAULT_ADDR=http://cloud-cost-vault-service:8200
VAULT_TOKEN=your_vault_token_here
