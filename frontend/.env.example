# Cloud Cost Detective — Frontend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# InsForge (Supabase-compatible) project URL
VITE_INSFORGE_PROJECT_URL=https://your-project.us-east.insforge.app

# InsForge anonymous/public API key (safe to expose to browser, but still not hardcoded)
VITE_INSFORGE_ANON_KEY=ik_your_anon_key_here

# Backend API base URL (leave empty if the backend is proxied by the same origin)
VITE_BACKEND_URL=

# WebSocket URL override (leave empty to auto-derive from window.location)
VITE_WS_URL=
